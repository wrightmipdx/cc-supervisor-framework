# Scratch is the shared workspace between the Supervisor and its workers.
# Traceable during a session, gone at retro. Never committed.
scratch/*
!scratch/.gitkeep

# Hook-written session event log. Counts and shapes, never content — but it is
# per-machine working data, not something to commit. .claude/scripts/metrics.sh
# reads it; docs/METRICS.md documents it.
.metrics/

# macOS
.DS_Store
**/.DS_Store

# This repo develops the framework and also runs on it. The hooks read
# docs/LEDGER*.md and docs/plans/*.md, so the framework's own ledger and plans
# have to live where the hooks look — but they are development notes, not part
# of what is released. Untracked here, still read by the hooks.
#
# Deliberately NOT ignored: docs/LEDGER.md and docs/LESSONS.md, which install.sh
# seeds into a consumer repo, and docs/plans/000-template.md, which ships.
docs/LEDGER-*.md
docs/LESSONS.md
docs/plans/*.md
!docs/plans/000-template.md
